# Copiar a .env con:  bash scripts/generar-env.sh
# (genera las contraseñas y el JWT_SECRET; el resto se completa a mano)
# Valores con espacios o símbolos van entre comillas dobles: EMAIL_PASS="abcd efgh ijkl mnop"

# ---------- Dominio / certificado ----------
DOMAIN=sistema.tudominio.com
CERTBOT_EMAIL=

# ---------- Imágenes (las publica GitHub Actions en ghcr.io) ----------
# Las versiones las escribe scripts/deploy.sh; no hace falta editarlas a mano.
REGISTRY=ghcr.io/jsplusinfra
# Nombre de cada imagen en el registro. Los repos de siempre: baseback y basefront.
# Los repos nuevos (Tablero*): tablerodistribuidoraback y tablerodistribuidorafront.
BACKEND_IMAGE=baseback
FRONTEND_IMAGE=basefront
BACKEND_TAG=
FRONTEND_TAG=

# ---------- Base de datos ----------
MYSQL_ROOT_PASSWORD=
DB_DATABASE=gestionDistribuidoraBv
DB_USERNAME=app
DB_PASSWORD=

# ---------- Backend ----------
JWT_SECRET=
JWT_EXPIRATION_ACCESS=60s
JWT_EXPIRATION_REFRESH=7d
PUNTO_VENTA_ACTIVO_ID=2
GOOGLE_CLIENT_ID=

# Cuenta de correo para recuperar contraseñas (Gmail: usar "contraseña de aplicación")
EMAIL_USER=
EMAIL_PASS=

# ---------- AFIP ----------
# homologacion | produccion
AFIP_ENV=homologacion
AFIP_CUIT=
AFIP_PUNTO_VENTA=
AFIP_LETRA_EMISOR=
# El certificado y la clave van como archivos en secrets/afip/AFIP.crt y secrets/afip/privada.key

# ---------- Estadísticas con Metabase (OPCIONAL: solo la línea BaseBack; los repos Tablero* traen tableros propios) ----------
# Contraseña del usuario de solo lectura de Metabase (la genera generar-env.sh).
METABASE_DB_PASSWORD=
# Admin de Metabase → Embedding → Static embedding: la "Embedding secret key".
METABASE_SECRET_KEY=
# Número del tablero de ventas (la URL de Metabase: /dashboard/<numero>-ventas).
METABASE_DASHBOARD_VENTAS=
# Resto de los tableros: el número de cada uno en la URL (/dashboard/<numero>-...). Vacío = sin armar.
METABASE_DASHBOARD_CLIENTES=
METABASE_DASHBOARD_NEGOCIO=
METABASE_DASHBOARD_COBRANZAS=
METABASE_DASHBOARD_FICHA=
METABASE_DASHBOARD_VENDEDORES=
# Memoria de Java para Metabase (con 768m usa ~1 GB en total).
METABASE_MEMORIA=768m

# ---------- Análisis con IA (Ollama) ----------
# Vacío = deshabilitado. Un modelo de 3B necesita 2-4 GB de RAM solo para él.
OLLAMA_URL=
OLLAMA_MODEL=

# ---------- Backups ----------
# Días que se guardan los backups locales que hace deploy.sh antes de migrar
RETENCION_DIAS=14
# Backup diario externo y cifrado (scripts/backup-externo.sh). Ver README, paso 7.
# Remoto de rclone + bucket + carpeta, ej. b2:sistema-backups-blanca/produccion
BACKUP_REMOTO=
# Clave PÚBLICA de age (age1...). La privada nunca va en el servidor.
BACKUP_AGE_DESTINATARIO=

# ---------- Tableros propios (solo los repos Tablero*; BaseBack los ignora) ----------
# Cada cuántos minutos se refresca la tabla de ventas de los tableros (0 = nunca solo).
TABLEROS_REFRESCO_MINUTOS=120
# Botón de análisis con IA (necesita Ollama; en un VPS chico, dejar en false).
IA_HABILITADA=false
# Seeds: dejar VACÍO en producción. Con true, los /api/seed-*/execute quedan abiertos.
HABILITAR_SEEDS=
SEED_ROOT_PASSWORD=
