# Etapa 1 (antes de tener certificado): solo HTTP, para el desafío de certbot.
# ${DOMAIN} se reemplaza con envsubst en scripts/03-ssl.sh.

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 503;
    }
}
